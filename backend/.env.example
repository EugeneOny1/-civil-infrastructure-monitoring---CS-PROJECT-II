# Server Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True
SECRET_KEY=civil-infra-secret-key-change-in-production
JWT_SECRET_KEY=civil-infra-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# MongoDB Connection
# Replace with your MongoDB Atlas or local connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/civil_infrastructure?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/civil_infrastructure
DB_NAME=civil_infrastructure

# Upload & File Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max upload size

# Model & Defect Detection Configuration (SSD-MobileNetV2)
MODEL_PATH=backend/models/structural_defect_detector
MODEL_VERSION=ssd_mobilenet_v2_lr00015_step1500_v2_1
DETECTION_CONFIDENCE_THRESHOLD=0.30
SEVERITY_LOW_THRESHOLD=0.05       # < 5% bounding box area is LOW severity
SEVERITY_CRITICAL_THRESHOLD=0.15  # >= 15% bounding box area is CRITICAL severity
DUPLICATE_IOU_THRESHOLD=0.50

# Two-Factor Authentication (2FA) & Real Email Delivery (SMTP)
# Configure with Gmail SMTP or custom relay credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=infravision-alerts@strathmore.edu
SMTP_USE_TLS=True

# OTP Security, Expiry & Rate Limiting
OTP_EXPIRY_SECONDS=300            # Verification passcode valid for 5 minutes
OTP_RESEND_COOLDOWN_SECONDS=60    # 60s cooldown between dispatch requests
OTP_MAX_ATTEMPTS=5                # Max failed attempts before code invalidation
OTP_MAX_SENDS_PER_HOUR=5          # Hourly dispatch rate limit per account
ENABLE_DEMO_OTP=True              # Set False in production to disable UI demo code autofill

# Google Identity Services (OAuth2 / GIS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GIS / Mapping (Leaflet + OpenStreetMap)
MAP_PROVIDER=leaflet
MAP_DEFAULT_LAT=-1.286389
MAP_DEFAULT_LNG=36.817223
MAP_DEFAULT_ZOOM=12
